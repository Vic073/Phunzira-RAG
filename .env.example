# Copy to .env and export, or set in your shell.
# Needed only for the Claude generator (otherwise the offline extractive generator is used).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional overrides
# PHUNZIRA_NOTES_DIR=data/notes
# PHUNZIRA_GLOSSARY=data/glossary.tsv
# PHUNZIRA_RETRIEVER=bm25+glossary      # bm25 | bm25+glossary | dense | hybrid
# PHUNZIRA_GENERATOR=auto               # auto | extractive | claude
# PHUNZIRA_EMBED_MODEL=intfloat/multilingual-e5-small
